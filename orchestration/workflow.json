{
  "name": "index-vs-trust-pipeline",
  "description": "Landing to Semantic, monthly. ETL only — the DDL runs once, from the index-vs-trust-pipeline-setup job.",
  "max_concurrent_runs": 1,
  "timeout_seconds": 3600,
  "git_source": {
    "git_url": "https://github.com/lucg-gith/index-vs-trust-pipeline",
    "git_provider": "gitHub",
    "git_branch": "main"
  },
  "schedule": {
    "quartz_cron_expression": "0 0 6 2 * ?",
    "timezone_id": "Europe/London",
    "pause_status": "UNPAUSED"
  },
  "email_notifications": {
    "on_failure": [
      "garrelucia@gmail.com"
    ]
  },
  "tasks": [
    {
      "task_key": "landing_etl_trusts",
      "notebook_task": {
        "notebook_path": "etl/00_landing/landing_etl_trusts",
        "source": "GIT"
      },
      "timeout_seconds": 1800
    },
    {
      "task_key": "landing_etl_trust_prices_csv",
      "notebook_task": {
        "notebook_path": "etl/00_landing/landing_etl_trust_prices_csv",
        "source": "GIT"
      },
      "timeout_seconds": 1800
    },
    {
      "task_key": "landing_etl_trust_prices_yf",
      "notebook_task": {
        "notebook_path": "etl/00_landing/landing_etl_trust_prices_yf",
        "source": "GIT"
      },
      "timeout_seconds": 1800,
      "max_retries": 1,
      "min_retry_interval_millis": 60000
    },
    {
      "task_key": "landing_etl_index_prices",
      "notebook_task": {
        "notebook_path": "etl/00_landing/landing_etl_index_prices",
        "source": "GIT"
      },
      "timeout_seconds": 1800,
      "max_retries": 1,
      "min_retry_interval_millis": 60000
    },
    {
      "task_key": "bronze_etl_trusts",
      "notebook_task": {
        "notebook_path": "etl/01_bronze/bronze_etl_trusts",
        "source": "GIT"
      },
      "timeout_seconds": 1800,
      "depends_on": [
        {
          "task_key": "landing_etl_trusts"
        }
      ]
    },
    {
      "task_key": "bronze_etl_trust_prices_csv",
      "notebook_task": {
        "notebook_path": "etl/01_bronze/bronze_etl_trust_prices_csv",
        "source": "GIT"
      },
      "timeout_seconds": 1800,
      "depends_on": [
        {
          "task_key": "landing_etl_trust_prices_csv"
        }
      ]
    },
    {
      "task_key": "bronze_etl_trust_prices_yf",
      "notebook_task": {
        "notebook_path": "etl/01_bronze/bronze_etl_trust_prices_yf",
        "source": "GIT"
      },
      "timeout_seconds": 1800,
      "depends_on": [
        {
          "task_key": "landing_etl_trust_prices_yf"
        }
      ]
    },
    {
      "task_key": "bronze_etl_yf_pull_log",
      "notebook_task": {
        "notebook_path": "etl/01_bronze/bronze_etl_yf_pull_log",
        "source": "GIT"
      },
      "timeout_seconds": 1800,
      "depends_on": [
        {
          "task_key": "landing_etl_trust_prices_yf"
        }
      ]
    },
    {
      "task_key": "bronze_etl_index_prices",
      "notebook_task": {
        "notebook_path": "etl/01_bronze/bronze_etl_index_prices",
        "source": "GIT"
      },
      "timeout_seconds": 1800,
      "depends_on": [
        {
          "task_key": "landing_etl_index_prices"
        }
      ]
    },
    {
      "task_key": "silver_etl_monthly_performance",
      "notebook_task": {
        "notebook_path": "etl/02_silver/silver_etl_monthly_performance",
        "source": "GIT"
      },
      "timeout_seconds": 1800,
      "depends_on": [
        {
          "task_key": "bronze_etl_trust_prices_yf"
        },
        {
          "task_key": "bronze_etl_index_prices"
        },
        {
          "task_key": "bronze_etl_trust_prices_csv"
        }
      ]
    },
    {
      "task_key": "silver_etl_ticker",
      "notebook_task": {
        "notebook_path": "etl/02_silver/silver_etl_ticker",
        "source": "GIT"
      },
      "timeout_seconds": 1800,
      "depends_on": [
        {
          "task_key": "silver_etl_monthly_performance"
        },
        {
          "task_key": "bronze_etl_trusts"
        },
        {
          "task_key": "bronze_etl_yf_pull_log"
        }
      ]
    },
    {
      "task_key": "gold_etl_dim_date",
      "notebook_task": {
        "notebook_path": "etl/03_gold/gold_etl_dim_date",
        "source": "GIT"
      },
      "timeout_seconds": 1800,
      "depends_on": [
        {
          "task_key": "silver_etl_monthly_performance"
        }
      ]
    },
    {
      "task_key": "gold_etl_dim_ticker",
      "notebook_task": {
        "notebook_path": "etl/03_gold/gold_etl_dim_ticker",
        "source": "GIT"
      },
      "timeout_seconds": 1800,
      "depends_on": [
        {
          "task_key": "silver_etl_ticker"
        }
      ]
    },
    {
      "task_key": "gold_etl_fact_monthly_performance",
      "notebook_task": {
        "notebook_path": "etl/03_gold/gold_etl_fact_monthly_performance",
        "source": "GIT"
      },
      "timeout_seconds": 1800,
      "depends_on": [
        {
          "task_key": "gold_etl_dim_date"
        },
        {
          "task_key": "gold_etl_dim_ticker"
        }
      ]
    },
    {
      "task_key": "gold_etl_fact_horizon_performance",
      "notebook_task": {
        "notebook_path": "etl/03_gold/gold_etl_fact_horizon_performance",
        "source": "GIT"
      },
      "timeout_seconds": 1800,
      "depends_on": [
        {
          "task_key": "gold_etl_dim_date"
        },
        {
          "task_key": "gold_etl_dim_ticker"
        }
      ]
    }
  ]
}
