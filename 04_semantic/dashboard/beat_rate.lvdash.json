{
  "datasets": [
    {
      "name": "kpi",
      "displayName": "Index, best trust and rank for the selected horizon and measure",
      "queryLines": [
        "-- One row once both filters are applied. Every counter reads a column of it.\n",
        "SELECT * FROM `index-vs-trust-pipeline`.semantic.v_measure_summary"
      ]
    },
    {
      "name": "by_horizon",
      "displayName": "Share of trusts above the index, every horizon",
      "queryLines": [
        "-- Deliberately not filtered by horizon: this tile exists to show all five at once.\n",
        "SELECT horizon_years, measure, pct_above, trusts_above, trusts\n",
        "FROM `index-vs-trust-pipeline`.semantic.v_measure_summary"
      ]
    },
    {
      "name": "by_house",
      "displayName": "Share above the index by management group",
      "queryLines": [
        "-- Houses with 3 or more trusts only. A 100% rate off one trust is noise wearing a\n",
        "-- finding's clothes, so the count travels inside the label.\n",
        "SELECT horizon_years, measure,\n",
        "       CONCAT(TRIM(REGEXP_REPLACE(REPLACE(management_group, ' (UK)', ''),\n",
        "              ' Asset Management| Investment Management| Global Investors| Investors', '')),\n",
        "              ' (', COUNT(*), ')')                                              AS house,\n",
        "       ROUND(100.0 * SUM(CASE WHEN beats_index THEN 1 ELSE 0 END) / COUNT(*), 1) AS pct_above\n",
        "FROM `index-vs-trust-pipeline`.semantic.v_measure\n",
        "WHERE entity_type = 'Trust' AND management_group IS NOT NULL\n",
        "GROUP BY horizon_years, measure, management_group\n",
        "HAVING COUNT(*) >= 3"
      ]
    },
    {
      "name": "survivorship",
      "displayName": "Including and excluding the delisted trusts",
      "queryLines": [
        "-- The gap between the cohorts is survivorship bias, in percentage points.\n",
        "WITH c AS (\n",
        "  SELECT horizon_years, measure, 'all trusts' AS cohort, beats_index\n",
        "  FROM `index-vs-trust-pipeline`.semantic.v_measure WHERE entity_type = 'Trust'\n",
        "  UNION ALL\n",
        "  SELECT horizon_years, measure, 'survivors only', beats_index\n",
        "  FROM `index-vs-trust-pipeline`.semantic.v_measure WHERE entity_type = 'Trust' AND status = 'active'\n",
        ")\n",
        "SELECT horizon_years, measure, cohort,\n",
        "       ROUND(100.0 * SUM(CASE WHEN beats_index THEN 1 ELSE 0 END) / COUNT(*), 1) AS pct_above\n",
        "FROM c GROUP BY horizon_years, measure, cohort"
      ]
    },
    {
      "name": "top20",
      "displayName": "Top 20 on the selected measure, with the index ranked in",
      "queryLines": [
        "-- The index always appears, even when it ranks well outside the top 20 (it does, on income).\n",
        "-- It is marked in the data because a table cell cannot be conditionally coloured here.\n",
        "SELECT horizon_years, measure, rank_in_measure,\n",
        "       CASE WHEN entity_type = 'Index' THEN CONCAT('◆ ', ticker)\n",
        "            ELSE ticker END                                            AS ticker,\n",
        "       CASE WHEN entity_type = 'Index' THEN UPPER(CONCAT('◆ THE INDEX  ', ticker))\n",
        "            ELSE trust_name END                                        AS trust_name,\n",
        "       CASE WHEN entity_type = 'Index' THEN '◆ no manager'\n",
        "            ELSE manager END                                           AS manager,\n",
        "       value_pct, beats_index\n",
        "FROM `index-vs-trust-pipeline`.semantic.v_measure\n",
        "WHERE rank_in_measure <= 20 OR ticker = 'SPY'"
      ]
    }
  ],
