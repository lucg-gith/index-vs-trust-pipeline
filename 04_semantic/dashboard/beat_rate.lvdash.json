{
  "datasets": [
    {
      "name": "kpi_headline",
      "displayName": "Headline at the selected horizon",
      "queryLines": [
        "-- One row. Cohort is hard-coded so the headline is never the flattered number.\n",
        "SELECT *\n",
        "FROM `index-vs-trust-pipeline`.semantic.v_beat_rate\n",
        "WHERE cohort = 'all trusts'\n",
        "  AND horizon_years = :horizon"
      ],
      "parameters": [
        {
          "displayName": "horizon",
          "keyword": "horizon",
          "dataType": "INTEGER",
          "defaultSelection": {
            "values": {
              "dataType": "INTEGER",
              "values": [
                {
                  "value": "15"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "beat_rate_by_horizon",
      "displayName": "Beat rate at every horizon",
      "queryLines": [
        "-- Deliberately unfiltered by horizon: this tile exists to show all five at once.\n",
        "SELECT horizon_years, beat_rate_pct, beat_count, trusts\n",
        "FROM `index-vs-trust-pipeline`.semantic.v_beat_rate\n",
        "WHERE cohort = 'all trusts'"
      ]
    },
    {
      "name": "risk_reward",
      "displayName": "Every ticker, risk against reward",
      "queryLines": [
        "-- One dot per trust, plus SPY. IVV and VOO are dropped: they sit on the same point as SPY\n",
        "-- and rendered as a single dot, which misrepresents how many trackers are on the chart.\n",
        "WITH spy AS (\n",
        "  SELECT horizon_years, volatility_pct AS spy_vol, annualised_return_pct AS spy_ret\n",
        "  FROM `index-vs-trust-pipeline`.semantic.v_leaderboard\n",
        "  WHERE ticker = 'SPY'\n",
        ")\n",
        "SELECT l.ticker, l.name, l.management_group, l.manager,\n",
        "       l.volatility_pct, l.annualised_return_pct, l.beat_index,\n",
        "       -- The legend does the explaining, so the chart needs no quadrant lines.\n",
        "       CASE WHEN l.entity_type = 'Index'                    THEN 'The S&P 500'\n",
        "            WHEN l.annualised_return_pct > s.spy_ret\n",
        "             AND l.volatility_pct       < s.spy_vol         THEN 'Beat it, and calmer'\n",
        "            WHEN l.annualised_return_pct > s.spy_ret         THEN 'Beat it, but bumpier'\n",
        "            WHEN l.volatility_pct       < s.spy_vol         THEN 'Lost to it, but calmer'\n",
        "            ELSE 'Lost to it, and bumpier'\n",
        "       END AS outcome\n",
        "FROM `index-vs-trust-pipeline`.semantic.v_leaderboard l\n",
        "JOIN spy s ON s.horizon_years = l.horizon_years\n",
        "WHERE l.horizon_years = :horizon\n",
        "  AND (l.entity_type = 'Trust' OR l.ticker = 'SPY')"
      ],
      "parameters": [
        {
          "displayName": "horizon",
          "keyword": "horizon",
          "dataType": "INTEGER",
          "defaultSelection": {
            "values": {
              "dataType": "INTEGER",
              "values": [
                {
                  "value": "15"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "survivorship",
      "displayName": "All trusts against survivors only",
      "queryLines": [
        "-- The gap between the two cohorts is survivorship bias, in percentage points.\n",
        "SELECT horizon_years, cohort, beat_rate_pct, trusts\n",
        "FROM `index-vs-trust-pipeline`.semantic.v_beat_rate"
      ]
    },
    {
      "name": "winners",
      "displayName": "Top ten trusts and who ran them",
      "queryLines": [
        "-- Top 20 by return with the index ranked among them, so where it lands is always visible.\n",
        "-- An index has no manager; that absence is the comparison, so the cell says so.\n",
        "SELECT rank_by_return, ticker, name,\n",
        "       CASE WHEN entity_type = 'Index' THEN 'INDEX' ELSE manager END          AS manager,\n",
        "       CASE WHEN entity_type = 'Index' THEN 'INDEX' ELSE management_group END AS management_group,\n",
        "       annualised_return_pct, volatility_pct, beat_index\n",
        "FROM `index-vs-trust-pipeline`.semantic.v_leaderboard\n",
        "WHERE horizon_years = :horizon\n",
        "  AND (rank_by_return <= 20 OR ticker = 'SPY')\n",
        "ORDER BY rank_by_return"
      ],
      "parameters": [
        {
          "displayName": "horizon",
          "keyword": "horizon",
          "dataType": "INTEGER",
          "defaultSelection": {
            "values": {
              "dataType": "INTEGER",
              "values": [
                {
                  "value": "15"
                }
              ]
            }
          }
        }
      ]
    }
  ],
